<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0E1621" android:fitsSystemWindows="true" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/callType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="50dp" android:text="Səsli zəng" android:textColor="#93A4B5" android:textSize="15sp"/>
    <TextView android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="34dp" android:background="@drawable/avatar_circle" android:gravity="center" android:text="●" android:textColor="#7AD7C4" android:textSize="40sp"/>
    <TextView android:id="@+id/personName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Qarşı tərəf" android:textColor="#F4F7FA" android:textSize="25sp" android:textStyle="bold"/>
    <TextView android:id="@+id/callStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Qoşulma hazırlanır…" android:textColor="#93A4B5" android:textSize="14sp"/>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="90dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/micBtn" android:layout_width="92dp" android:layout_height="58dp" android:text="Mikrofon"/>
        <Button android:id="@+id/speakerBtn" android:layout_width="92dp" android:layout_height="58dp" android:layout_marginStart="10dp" android:text="Səs"/>
        <Button android:id="@+id/endBtn" android:layout_width="92dp" android:layout_height="58dp" android:layout_marginStart="10dp" android:text="Bitir"/>
    </LinearLayout>
</LinearLayout>
